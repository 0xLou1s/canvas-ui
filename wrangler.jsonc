{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canvas-ui",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-12-01",
  "vars": {
    // When "true" the Worker refuses signups unless TURNSTILE_SECRET_KEY is set
    // and the request carries a valid token. Set to "false" only for local work.
    "TURNSTILE_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://canvasui.dev,https://www.canvasui.dev",
    // Contacts must live in an audience to be reachable by a Resend broadcast.
    "RESEND_AUDIENCE_ID": "5581ebcc-ba64-4d55-a5dc-747b5777a92a"
  },
  "ratelimits": [
    {
      "name": "SUBSCRIBE_IP_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "SUBSCRIBE_GLOBAL_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
